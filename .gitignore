# macOS 系统垃圾文件
.DS_Store

# Python 缓存
__pycache__/
*.pyc

# 数据库文件（运行时数据，不该提交）
*.db

# 虚拟环境
.venv/
venv/

# 日志
*.log

# pytest 缓存
.pytest_cache/

# ===== 密钥 / 凭据（绝不提交）=====
# 环境变量文件：SECRET_KEY、JWT 密钥、数据库密码都写在这里
.env
.env.*
!.env.example
!.env.sample
.flaskenv

# 证书与私钥
*.pem
*.key
*.p12
*.pfx

# SSH 私钥（万一被拷进项目目录时兜底）
id_rsa
id_dsa
id_ecdsa
id_ed25519
.ssh/

# 云平台 / 服务账号凭据
credentials.json
serviceAccountKey.json
.netrc

