# ===== Docker 测试环境配置（可以提交到 git）=====
#
# 这是给 docker-compose.test.yml 用的测试配置，不是生产配置。
# 里面的密钥是「测试专用假密钥」—— 故意公开、故意固定：
#   测试工程师和 CI 都用同一份，不会因为各人密钥不同而互相干扰，
#   也不会有人误以为它是需要保密的真密钥。
#
# ⚠️ 生产环境绝对不要用这个文件，上线时另配一份真实随机密钥。
#
# 为什么必须填一个非空值？
#   app.py 里 SECRET_KEY 读不到会直接 RuntimeError 拒绝启动（有意做的加固）。
#   .env.example 是个空模板，拿它当测试配置会让容器启动瞬间崩掉 ——
#   所以测试环境需要自己这份「有值」的文件。
#
# 为什么密钥要写这么长（55 字节）？
#   HS256 的安全下限是 32 字节，短于这个长度 PyJWT 会抛
#   InsecureKeyLengthWarning。原来填的 super-secret-test-key-123 只有 25 字节，
#   正好踩在这条线下，所以换成了下面这个。

AUTH_SECRET_KEY=test_only_fake_key_for_docker_test_env_0123456789abcdef

# 如果后续有数据库等其他必填变量，也写在这个文件里