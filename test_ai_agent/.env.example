# service/llm.py 的配置模板。
# 复制本文件为环境变量设置，或直接 export：
#
#   export LLM_API_KEY=sk-xxxx
#   export LLM_BASE_URL=https://api.deepseek.com/v1   # 默认 DeepSeek，OpenAI 兼容地址也行
#   export LLM_MODEL=deepseek-chat                     # 默认模型名
#   export LLM_TIMEOUT=60                              # 请求超时（秒）

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
